NODE_ENV=production
BYBIT_TESTNET=false
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=ETHUSDT
BYBIT_REST_BASE=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

CANDLE_LIMIT=1000
CANDLE_INTERVALS=1,5,15,60,240,D
MARK_INDEX_PREMIUM_ENABLED=true

DERIVATIVES_REFRESH_MS=60000
RECONCILE_MS=60000
ORDERBOOK_DEPTH=50
PERSIST_ORDERBOOK_UPDATES=true
PERSIST_RAW_EVENTS=false

STORAGE_FLUSH_MS=500
STORAGE_BATCH_SIZE=200

SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8787
API_READ_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

LOG_LEVEL=info
